{
  "kind": "collectionType",
  "collectionName": "social_work_galleries",
  "info": {
    "singularName": "social-work-gallery",
    "pluralName": "social-work-galleries",
    "displayName": "Social Work Gallery",
    "description": "Gallery for social work activities"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "date": {
      "type": "date"
    },
    "context": {
      "type": "enumeration",
      "enum": [
        "Help People",
        "Medical Support",
        "Education Support",
        "Disaster Relief",
        "Other"
      ]
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
}
